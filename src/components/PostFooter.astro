---
type Props = {
  prev?: {
    title: string;
    href: string;
  };
  next?: {
    title: string;
    href: string;
  };
}
const { prev, next } = Astro.props;
---

<hr class="my-8 border-slate-300 dark:border-slate-700" />

    <div class="flex justify-between p-3 gap-8 text-accent">
      {prev && (
          <a
            href={prev.href}
            class="flex gap-2 items-center transition-color duration-200 hover:text-brand-300 dark:hover:text-brand-400"
          >
            <span>{`< `}</span> {prev.title}
          </a>
        )}
      {next && (
          <a
            href={next.href}
            class="flex gap-2 items-center transition-color duration-200 hover:text-brand-300 dark:hover:text-brand-400"
          >
            {next.title} <span>{` >`}</span>
          </a>
        )}
    </div>