---
import InstagramEmbed, {
  type InstagramEmbedProps,
} from '@components/InstagramEmbed.astro'
import { cn } from '@lib/utils'

type Props = {
  posts: Omit<InstagramEmbedProps, 'layout'>[]
  /** columns from the listed breakpoint up; mobile stays a single column */
  columns?: 2 | 3
}

const { posts, columns = 2 } = Astro.props

const gridClass = cn(
  'not-prose my-6 grid w-full grid-cols-1 gap-4',
  columns === 3 ? 'lg:grid-cols-3' : 'md:grid-cols-2',
)
---

{posts.length > 0 && (
    <div class={gridClass}>
      {posts.map((post) => (
        <InstagramEmbed {...post} layout="grid" />
      ))}
    </div>
  )}
