---
import { cn } from '@lib/utils'

export type InstagramEmbedProps = {
  embedId: string
  imageUrl: string
  title: string
  alt?: string
  /** reel uses /reel/ or /{username}/reel/; post uses /p/ */
  kind?: 'reel' | 'p'
  username?: string
  /** fill a grid cell instead of a centered article column */
  layout?: 'default' | 'grid'
}

type Props = InstagramEmbedProps

const {
  embedId,
  imageUrl,
  title,
  alt = '',
  kind = 'p',
  username = 'joelmturner',
  layout = 'default',
} = Astro.props

const href =
  kind === 'reel'
    ? username
      ? `https://www.instagram.com/${username}/reel/${embedId}/`
      : `https://www.instagram.com/reel/${embedId}/`
    : `https://www.instagram.com/p/${embedId}/`

const fallbackSrc =
  'https://static.cdninstagram.com/rsrc.php/yw/r/icwX0xAk0pz.webp'
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={cn(
    "not-prose block w-full overflow-hidden rounded-xl border border-border bg-surface-default text-inherit no-underline shadow-lg transition-shadow duration-200 hover:shadow-xl",
    layout === "grid" ? "my-0 max-w-none" : "mx-auto my-6 max-w-[460px]",
  )}
>
  <div class="aspect-square w-full overflow-hidden bg-surface-muted">
    <img
      src={imageUrl}
      alt={alt}
      loading="lazy"
      decoding="async"
      class="block h-full w-full object-cover"
      onerror={`this.onerror=null;this.src='${fallbackSrc}';this.style.objectFit='contain';this.style.padding='15%'`}
    />
  </div>
  <div class="flex flex-col gap-1.5 px-4 py-3.5">
    <p class="m-0 text-base leading-snug text-foreground">{title}</p>
  </div>
</a>
